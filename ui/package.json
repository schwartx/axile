{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.13"
  },
  "scripts": {
    "build:analysis": "uv run --no-project python ../scripts/build_browser_analysis.py",
    "dev": "bun run build:analysis && vite",
    "build": "bun run build:analysis && bun run typecheck && vite build",
    "typecheck": "tsrs -b --noEmit",
    "test": "bun test",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/lsp-client": "^6.3.0",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@number-flow/react": "^0.6.2",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@uiw/react-codemirror": "^4.25.11",
    "dompurify": "^3.4.15",
    "lucide-react": "^1.31.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.1.0",
    "vscode-languageserver-protocol": "^3.18.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "~7.0.2",
    "vite": "^8.1.1"
  }
